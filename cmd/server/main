// Command server runs both the HTTP API (for enqueueing tasks / stats) and
// the worker pool (for processing them) in a single process — simple to
// deploy, and easy to split into separate api/worker binaries later if you
// need to scale them independently.
package main

import (
	"context"
	"encoding/json"
	"log"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"github.com/redis/go-redis/v9"

	"github.com/YOUR_USERNAME/taskqueue/internal/api"
	"github.com/YOUR_USERNAME/taskqueue/internal/queue"
	"github.com/YOUR_USERNAME/taskqueue/internal/worker"
)

func main() {
	redisAddr := getEnv("REDIS_ADDR", "localhost:6379")
	httpAddr := getEnv("HTTP_ADDR", ":8080")
	concurrency := 4

	rdb := redis.NewClient(&redis.Options{Addr: redisAddr})

	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	if err := rdb.Ping(ctx).Err(); err != nil {
		cancel()
		log.Fatalf("failed to connect to redis at %s: %v", redisAddr, err)
	}
	cancel()

	q := queue.New(rdb, "default")

	pool := worker.NewPool(q)
	registerHandlers(pool)

	runCtx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	go pool.Run(runCtx, concurrency)

	server := api.NewServer(q)
	httpServer := &http.Server{Addr: httpAddr, Handler: server.Routes()}

	go func() {
		log.Printf("HTTP API listening on %s", httpAddr)
		if err := httpServer.ListenAndServe(); err != nil && err != http.ErrServerClosed {
			log.Fatalf("http server error: %v", err)
		}
	}()

	<-runCtx.Done()
	log.Println("shutting down...")

	shutdownCtx, shutdownCancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer shutdownCancel()
	_ = httpServer.Shutdown(shutdownCtx)
}

// registerHandlers wires up example task types. In a real deployment,
// these would call out to email providers, image processors, etc.
func registerHandlers(pool *worker.Pool) {
	pool.RegisterHandler("send_email", func(ctx context.Context, payload []byte) error {
		var p struct {
			To      string `json:"to"`
			Subject string `json:"subject"`
		}
		if err := json.Unmarshal(payload, &p); err != nil {
			return err
		}
		log.Printf("[send_email] sending to=%s subject=%q", p.To, p.Subject)
		time.Sleep(100 * time.Millisecond) // simulate work
		return nil
	})

	pool.RegisterHandler("resize_image", func(ctx context.Context, payload []byte) error {
		var p struct {
			URL string `json:"url"`
		}
		if err := json.Unmarshal(payload, &p); err != nil {
			return err
		}
		log.Printf("[resize_image] processing url=%s", p.URL)
		time.Sleep(150 * time.Millisecond)
		return nil
	})
}

func getEnv(key, fallback string) string {
	if v := os.Getenv(key); v != "" {
		return v
	}
	return fallback
}
